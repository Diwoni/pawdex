# Local daemon
PAWDEX_PORT=8787
# Optional defense-in-depth for the loopback-only feasibility spike.
PAWDEX_AUTH_TOKEN=replace-with-a-long-random-token

# Optional Web Push. Generate with: pnpm --filter @pawdex/daemon vapid
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional custom meow file for macOS. Falls back to a built-in sound.
PAWDEX_SOUND_FILE=
